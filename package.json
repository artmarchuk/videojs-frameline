{
  "name": "videojs-frameline",
  "version": "0.0.0",
  "homepage": "https://frameline.artmarchuk.me/",
  "author": "Artem Marchuk",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "npx --yes vercel@64 build --prod && npx --yes vercel@64 deploy --prebuilt --prod",
    "deploy:netlify": "npx --yes netlify-cli@27 deploy --build",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name videojs-frameline",
    "test": "vitest run"
  },
  "dependencies": {
    "@videojs/core": "10.4.0",
    "@videojs/react": "10.4.0",
    "@videojs/utils": "10.4.0",
    "cn": "^0.4.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/core": "2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "playwright-core": "^1.65.1",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
